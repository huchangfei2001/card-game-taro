{
  "name": "card-game-platform-taro",
  "version": "1.0.0",
  "private": true,
  "description": "棋牌游戏平台 - Taro多端版本",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "sass"
  },
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "build:swan": "taro build --type swan",
    "build:alipay": "taro build --type alipay",
    "build:tt": "taro build --type tt",
    "build:h5": "taro build --type h5",
    "dev:weapp": "npm run build:weapp -- --watch",
    "dev:swan": "npm run build:swan -- --watch",
    "dev:alipay": "npm run build:alipay -- --watch",
    "dev:tt": "npm run build:tt -- --watch",
    "dev:h5": "npm run build:h5 -- --watch"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "dependencies": {
    "@tarojs/components": "3.6.25",
    "@tarojs/helper": "3.6.25",
    "@tarojs/plugin-framework-react": "3.6.25",
    "@tarojs/plugin-platform-alipay": "3.6.25",
    "@tarojs/plugin-platform-h5": "^3.6.25",
    "@tarojs/plugin-platform-swan": "3.6.25",
    "@tarojs/plugin-platform-tt": "3.6.25",
    "@tarojs/plugin-platform-weapp": "3.6.25",
    "@tarojs/react": "^3.6.25",
    "@tarojs/runtime": "3.6.25",
    "@tarojs/shared": "3.6.25",
    "@tarojs/taro": "3.6.25",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/runtime": "^7.21.0",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.2",
    "@tarojs/cli": "3.6.25",
    "@tarojs/webpack5-runner": "3.6.25",
    "@types/react": "^18.2.0",
    "babel-preset-taro": "3.6.25",
    "css-loader": "^6.7.1",
    "react-refresh": "^0.18.0",
    "sass": "^1.62.0",
    "style-loader": "^3.3.1",
    "typescript": "^5.0.0",
    "webpack": "^5.90.0",
    "webpack-virtual-modules": "^0.5.0"
  }
}
